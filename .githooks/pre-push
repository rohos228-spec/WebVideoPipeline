#!/usr/bin/env bash
# Gauntlet, ярус push (.claude/verify.json → ~/.agents/hooks/verify.sh).
# Подключение — один раз на клон:  git config core.hooksPath .githooks
# Без движка (машина заказчика) хук молчит: тот же контракт гоняет CI.
engine="$HOME/.agents/hooks/verify.sh"
[ -x "$engine" ] || { echo "pre-push: нет $engine — gauntlet пропущен" >&2; exit 0; }

# git пишет строки ссылок в stdin хука. На длинном прогоне (полная суита с
# покрытием, >10 мин) неслитый stdin даёт EPIPE, и git умирает с кодом 141 —
# молча, до единой строки в логе. Поэтому читаем сразу и с таймаутом: голый
# `cat` ждёт EOF, которого git не даёт, и вешает хук.
refs=$(timeout 2 cat 2>/dev/null || true)

# Дедупликация прогона (2026-09-15). Выкладка идёт в два шага: сперва пуш
# ветки, потом перемотка main на неё. Коммиты одни и те же, а гейт шёл
# дважды — двадцать лишних минут на каждую выкладку.
#
# Пропускаем ТОЛЬКО когда каждый отправляемый коммит уже лежит на origin,
# то есть уже прошёл этот же гейт. Любой коммит, которого на origin нет,
# возвращает полный прогон. Ссылки освежаем fetch'ем, иначе решение
# принималось бы по устаревшему представлению об удалённом репозитории.
if [ -n "$refs" ]; then
  git fetch --quiet --prune "${1:-origin}" >/dev/null 2>&1 || true
  unseen=0
  seen_any=0
  while read -r _local_ref local_sha _remote_ref _remote_sha; do
    [ -z "$local_sha" ] && continue
    # удаление ветки: локальный sha из одних нулей — гонять нечего
    case "$local_sha" in *[!0]*) : ;; *) continue ;; esac
    seen_any=1
    if ! git branch -r --contains "$local_sha" 2>/dev/null | grep -q .; then
      unseen=1
      break
    fi
  done <<EOF
$refs
EOF
  if [ "$seen_any" = 1 ] && [ "$unseen" = 0 ]; then
    echo "pre-push: эти коммиты уже на origin и уже прошли gauntlet — прогон пропущен" >&2
    exit 0
  fi
fi

exec "$engine" --stage push
