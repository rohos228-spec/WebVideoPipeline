# Локальная история версий промтов (не коммитим)
prompts/**/.history/

# Все промты — только локально (не тянуть с GitHub при install/update)
prompts/*
!prompts/.gitkeep
# Промпты scene_design — часть кода ноды, без них load_prompt падает: держим в git
!prompts/scene_design/
# Промпты scene-агентов веера (группа «Сцены: веер агентов») — часть пресета,
# наследуются всеми ПК: держим в git
!prompts/05_excel_gpt/
!prompts/05_excel_gpt/sd_*.md
!prompts/04_hero/

# Статическая сборка студии (next export) — артефакт, не исходник.
web/out/
# Одиночные кадры, которые роняют в корень отладочные скрипты.
/out.png

# Состояние входа для e2e: содержит живой сессионный токен.
web/e2e/.auth/

# Отчёты покрытия: собираются прогоном, в git не хранятся.
coverage/
.coverage

# Отчёты Playwright: артефакты прогона.
web/playwright-report/
web/test-results/

# Секреты и состояние выкладки на VPS.
deploy/studio/env
deploy/studio/prompts/
deploy/studio/backups/
deploy/studio/.last-image

# ключи в любом dotenv-файле с любым суффиксом — не в git (у заказчика такой файл читался кодом)
.env.env
