# =============================================================================
# VIDEO PIPELINE WEB STUDIO — ПРИМЕР КОНФИГУРАЦИОННОГО ФАЙЛА (.env.example)
# Скопируйте этот файл в .env и подставьте свои реальные API-ключи:
# copy .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# ОСНОВНЫЕ НАСТРОЙКИ СТУДИИ И ВЕБ-СЕРВЕРА
# -----------------------------------------------------------------------------
# Ветка оркестратора для синхронизации
ORCHESTRATOR_GIT_BRANCH=main

# Папка данных проектов
DATA_DIR=./data

# Папка системных логов
LOGS_DIR=

# Путь к файлу базы данных SQLite
SQLITE_PATH=./data/state.db

# Логин для доступа к веб-студии (если включена авторизация)
WEB_AUTH_USER=admin

# Пароль для веб-студии
WEB_AUTH_PASSWORD=your_web_auth_password_here

# -----------------------------------------------------------------------------
# ТЕКСТ И СЦЕНАРИИ (LLM)
# -----------------------------------------------------------------------------
# Активный текстовый провайдер: kie | vibecode
TEXT_LLM_PROVIDER=kie

# API-ключ основного текстового провайдера (Kie.ai)
GPT_API_KEY=your_gpt_api_key_here

# Базовый URL для Kie.ai
GPT_BASE_URL=https://gpt.zukiemi.space

# Путь эндпоинта (обычно /codex/v1/responses)
GPT_CHAT_PATH=/codex/v1/responses

# Модель по умолчанию (gpt-5-6-sol)
GPT_MODEL=gpt-5-6-sol

# Режим API (auto | responses | chat)
GPT_API_MODE=auto

# Строгий формат схемы ответов JSON (auto | on | off)
GPT_STRUCTURED_OUTPUTS=

# Таймаут запросов LLM в секундах
GPT_TIMEOUT_S=600

# Количество повторных попыток при сбоях
GPT_MAX_RETRIES=4

# API-ключ альтернативного провайдера Vibecode (Claude, Gemini)
VIBECODE_API_KEY=your_vibecode_api_key_here

# Базовый URL Vibecode
VIBECODE_BASE_URL=https://vibecode.moe/v1

# Лимит расходов на LLM на один проект (USD)
LLM_BUDGET_USD=

# -----------------------------------------------------------------------------
# ГЕНЕРАЦИЯ ИЗОБРАЖЕНИЙ И ВИДЕО (OUTSEE & KIE)
# -----------------------------------------------------------------------------
# Провайдер изображений по умолчанию: outsee
IMAGE_PROVIDER=outsee

# Провайдер видео по умолчанию: outsee
VIDEO_PROVIDER=outsee

# API-ключ Outsee (из профиля outsee.io)
OUTSEE_API_KEY=your_outsee_api_key_here

# Базовый URL API Outsee
OUTSEE_API_BASE_URL=https://outsee.io

# Модель картинок по умолчанию (gpt-image-2)
OUTSEE_DEFAULT_IMAGE_MODEL=gpt-image-2

# Модель видео по умолчанию (veo-3-1-lite)
OUTSEE_DEFAULT_VIDEO_MODEL=veo-3-1-lite

# Откат на браузерный Chrome CDP при недоступности API
OUTSEE_HTTP_FALLBACK_CDP=true

# Режим глобальной очереди генерации Outsee
OUTSEE_QUEUE_MODE=true

# Таймаут скачивания готового медиафайла в секундах
OUTSEE_DOWNLOAD_TIMEOUT_S=120.0

# Максимальное число параллельных задач в Outsee (до 4)
CREATE_MAX_PARALLEL_OUTSEE=4

# Параллельные потоки генерации кадров пайплайна
IMG_MAX_STREAMS=2

# Параллельные потоки vision-проверок кадров
CHECK_MAX_STREAMS=2

# API-ключ Kie для каталога Kling и генераторов
KIE_API_KEY=your_kie_api_key_here

# Базовый URL Kie API
KIE_API_BASE_URL=https://api.kie.ai

# -----------------------------------------------------------------------------
# ОЗВУЧКА И ЗВУКОВЫЕ ЭФФЕКТЫ (ELEVENLABS)
# -----------------------------------------------------------------------------
# API-ключ ElevenLabs для генерации диктора (TTS) и саунд-эффектов (SFX)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# URL веб-интерфейса ElevenLabs
ELEVENLABS_WEB_URL=https://elevenlabs.io/app/speech-synthesis

# Использовать ElevenLabs для озвучки (1 = включено, 0 = только оффлайн-импорт)
AUDIO_USE_ELEVENLABS_FALLBACK=1

# Модель синтеза речи (eleven_multilingual_v2)
ELEVENLABS_TTS_MODEL=

# Формат аудиопотока (mp3_44100_128)
ELEVENLABS_OUTPUT_FORMAT=

# Включить генерацию саунд-эффектов в пайплайне
SFX_ENABLED=

# -----------------------------------------------------------------------------
# СУБТИТРЫ И РАСПОЗНАВАНИЕ РЕЧИ (ASR)
# -----------------------------------------------------------------------------
# Движок ASR: nvidia (NeMo Parakeet) или whisper
ASR_BACKEND=nvidia

# Модель Whisper для локального ASR (small, base, medium)
WHISPER_MODEL=small

# Устройство для Whisper (cpu или cuda)
WHISPER_DEVICE=cpu

# Тип вычислений Whisper (int8, float16)
WHISPER_COMPUTE_TYPE=int8

# Модель NVIDIA NeMo Parakeet для миллисекундных таймингов
NVIDIA_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3

# Предзагрузка модели ASR при старте Студии (false = lazy load)
NVIDIA_ASR_PRELOAD_ON_STARTUP=false

# Максимум слов на экране одновременно (по умолчанию 2)
SUBTITLE_MAX_WORDS=

# Опережение субтитрами звука (в секундах)
SUBTITLE_LEAD_SECONDS=

# -----------------------------------------------------------------------------
# МУЗЫКА И СБОРКА РОЛИКА (FFMPEG)
# -----------------------------------------------------------------------------
# Включить шаг генерации фоновой музыки (Suno)
MUSIC_ENABLED=

# Включать фоновую музыку при сборке по умолчанию
BGM_DEFAULT_ENABLED=false

# Громкость фоновой музыки (0..100)
BGM_DEFAULT_LEVEL=15

# Усиление громкости голоса диктора при финальном сведении
ASSEMBLY_VOICE_GAIN=1.5

# Коэффициент микширования фоновой музыки
ASSEMBLY_BGM_MIX_RATIO=

# -----------------------------------------------------------------------------
# БРАУЗЕР CHROME CDP (ДЛЯ РЕЗЕРВНОЙ АВТОМАТИЗАЦИИ)
# -----------------------------------------------------------------------------
# URL порта Chrome CDP (запущенного через Start-Chrome.cmd)
BROWSER_CDP_URL=http://127.0.0.1:29229

# Таймаут подключения к Chrome CDP (мс)
BROWSER_CDP_CONNECT_TIMEOUT_MS=45000

# Автоперезапуск Chrome при зависании сокета
BROWSER_CDP_AUTO_RECOVER=true

# -----------------------------------------------------------------------------
# ОБЛАЧНОЕ ХРАНИЛИЩЕ ДЛЯ РЕФЕРЕНС-КАДРОВ (YANDEX S3)
# -----------------------------------------------------------------------------
# Имя бакета для публикации временных референс-кадров
YANDEX_STORAGE_BUCKET=test2videogen

# Access Key ID
YANDEX_STORAGE_ACCESS_KEY=your_yandex_storage_access_key_here

# Secret Access Key
YANDEX_STORAGE_SECRET_KEY=your_yandex_storage_secret_key_here

# Эндпоинт хранилища (https://storage.yandexcloud.net)
YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net

# Регион бакета (ru-central1)
YANDEX_STORAGE_REGION=ru-central1

# -----------------------------------------------------------------------------
# МУЛЬТИКОМПЬЮТЕРНАЯ СЕТЬ (FLEET MODE)
# -----------------------------------------------------------------------------
# Включить распределённую сеть ПК (false для локальной студии)
FLEET_ENABLED=false

# Роль узла (hub или agent)
FLEET_ROLE=hub

# Является ли данный узел главным
FLEET_IS_MAIN=true

# Выполнять финальный монтаж на этом ПК
FLEET_MONTAGE_HUB=true

# URL главного хаба Студии
FLEET_HUB_URL=http://127.0.0.1:8765

# Имя текущего компьютера в сети
FLEET_NODE_NAME=main-pc

# -----------------------------------------------------------------------------
# АНАЛИТИКА И ТЕЛЕМЕТРИЯ (SUPABASE)
# -----------------------------------------------------------------------------
# URL проекта Supabase
SUPABASE_URL=https://jubhhajwknvhlntmwpoj.supabase.co

# Anon / service ключ Supabase
SUPABASE_KEY=your_supabase_key_here

