# =============================================================================
# VIDEO PIPELINE WEB STUDIO — ПРИМЕР КОНФИГУРАЦИИ (.env.example)
# Скопируйте в .env и впишите свои ключи: copy .env.example .env
# Пустые значения = дефолты кода. Секреты сюда не пишем, только имена.
# =============================================================================

# -----------------------------------------------------------------------------
# СТУДИЯ И БАЗА
# -----------------------------------------------------------------------------
# Папка данных проектов (кадры, видео, БД)
DATA_DIR=./data

# Папка логов
LOGS_DIR=

# Файл SQLite (боевой путь; на VPS — Postgres через DATABASE_URL, см. deploy/studio/)
SQLITE_PATH=./data/state.db

# Секрет подписи сессий (сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(48))").
# Пусто = режим владельца без входа (только для локального ПК!). С 0.0.0.0 без секрета старт откажет.
STUDIO_SESSION_SECRET=

# -----------------------------------------------------------------------------
# ТЕКСТ И СЦЕНАРИИ (LLM): kie по умолчанию, vibecode — альтернатива
# -----------------------------------------------------------------------------
TEXT_LLM_PROVIDER=kie

# Ключ текстового провайдера (kie.ai)
GPT_API_KEY=

# База текстового API (VPS-relay; прямой api.kie.ai — только без VPS)
GPT_BASE_URL=

# Путь chat-эндпоинта (обычно /codex/v1/responses)
GPT_CHAT_PATH=/codex/v1/responses

# Модель по умолчанию
GPT_MODEL=gpt-5-6-sol

# Режим API (auto | responses | chat)
GPT_API_MODE=auto

# Таймаут LLM, сек
GPT_TIMEOUT_S=600

# Повторы при сбоях
GPT_MAX_RETRIES=4

# Токен VPS-релея текстовых запросов (пусто = напрямую)
GPT_RELAY_TOKEN=

# Ключ Vibecode (Claude, Gemini — каталог в app/services/text_llm_catalog.py)
VIBECODE_API_KEY=

# База Vibecode
VIBECODE_BASE_URL=https://vibecode.moe/v1

# Лимит текстовых трат на проект, USD (пусто = дефолт 10; медиа не покрывает!)
LLM_BUDGET_USD=

# -----------------------------------------------------------------------------
# КАРТИНКИ И ВИДЕО: outsee по умолчанию, minimax и kie — по выбору
# -----------------------------------------------------------------------------
IMAGE_PROVIDER=outsee
VIDEO_PROVIDER=outsee

# Ключ Outsee (https://outsee.io/profile)
OUTSEE_API_KEY=

# База Outsee API
OUTSEE_API_BASE_URL=https://outsee.io

# Модели по умолчанию
OUTSEE_DEFAULT_IMAGE_MODEL=gpt-image-2
OUTSEE_DEFAULT_VIDEO_MODEL=veo-3-1-lite

# Откат на браузерный Chrome CDP при недоступности API (на сервере — false!)
OUTSEE_HTTP_FALLBACK_CDP=true

# Публиковать стартовый кадр только через Yandex S3 (true = разрешить
# анонимные файлохостинги; кадр утекает наружу — только осознанно)
OUTSEE_ALLOW_PUBLIC_HOSTS=

# Очередь генераций Outsee
OUTSEE_QUEUE_MODE=true

# Таймаут скачивания результата, сек
OUTSEE_DOWNLOAD_TIMEOUT_S=120.0

# Параллелизм Create (остальные ждут в очереди)
CREATE_MAX_PARALLEL_OUTSEE=4

# Параллельные кадры пайплайна (0 = не генерить)
IMG_MAX_STREAMS=2

# Параллельные vision-проверки
CHECK_MAX_STREAMS=2

# Ключ Kie (Market: Kling, Seedance, Hailuo, Suno + каталог Create)
KIE_API_KEY=

# База Kie API
KIE_API_BASE_URL=https://api.kie.ai

# База загрузки файлов Kie (рефы image/video/audio)
KIE_UPLOAD_BASE_URL=https://kieai.redpandaai.co

# -----------------------------------------------------------------------------
# ОЗВУЧКА (ELEVENLABS)
# -----------------------------------------------------------------------------
ELEVENLABS_API_KEY=

# Витрина голосов в браузере (не используется кодом напрямую)
ELEVENLABS_WEB_URL=https://elevenlabs.io/app/speech-synthesis

# Откат озвучки на ElevenLabs при недоступности основного пути (1/0)
AUDIO_USE_ELEVENLABS_FALLBACK=1

# Модель TTS (пусто = дефолт кода)
ELEVENLABS_TTS_MODEL=

# Формат аудио (пусто = дефолт кода)
ELEVENLABS_OUTPUT_FORMAT=

# Саунд-эффекты в пайплайне (пусто = дефолт кода)
SFX_ENABLED=

# -----------------------------------------------------------------------------
# СУБТИТРЫ И РАСПОЗНАВАНИЕ (ASR)
# -----------------------------------------------------------------------------
# Движок: whisper (CPU) или nvidia (NeMo Parakeet, нужен CUDA)
ASR_BACKEND=nvidia

WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

NVIDIA_ASR_MODEL=nvidia/parakeet-tdt-0.6b-v3

# Грузить Parakeet при старте (true = +8 ГБ RAM сразу, false = лениво на шаге «Аудио»)
NVIDIA_ASR_PRELOAD_ON_STARTUP=false

# Слов на экране (пусто = дефолт), опережение субтитров, сек (пусто = дефолт)
SUBTITLE_MAX_WORDS=
SUBTITLE_LEAD_SECONDS=

# -----------------------------------------------------------------------------
# МУЗЫКА И СБОРКА (FFMPEG)
# -----------------------------------------------------------------------------
# Шаг фоновой музыки Suno (пусто = дефолт кода)
MUSIC_ENABLED=

BGM_DEFAULT_ENABLED=false
BGM_DEFAULT_LEVEL=15
ASSEMBLY_VOICE_GAIN=1.5
ASSEMBLY_BGM_MIX_RATIO=

# -----------------------------------------------------------------------------
# РЕФЕРЕНС-КАДРЫ (YANDEX S3, обязательно для Outsee image2video)
# -----------------------------------------------------------------------------
# Имя бакета (чтение «для всех»)
YANDEX_STORAGE_BUCKET=

# Статический ключ сервисного аккаунта (НЕ коммитить!)
YANDEX_STORAGE_ACCESS_KEY=
YANDEX_STORAGE_SECRET_KEY=

YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YANDEX_STORAGE_REGION=ru-central1

# -----------------------------------------------------------------------------
# ПАРАЛЛЕЛЬ ПРОЕКТОВ
# -----------------------------------------------------------------------------
# Сколько проектов одновременно (1 = строго по одному)
WORKER_MAX_PARALLEL=1

# -----------------------------------------------------------------------------
# ВЕБ-ИНТЕРФЕЙС
# -----------------------------------------------------------------------------
WEB_ENABLED=true
WEB_HOST=127.0.0.1
WEB_PORT=8765
