* text=auto
*.ts text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.png binary
*.jpg binary
*.mp4 binary
*.woff2 binary
*.xlsx binary
# PowerShell & Batch files on Windows: CRLF checkout on every OS.
# UTF-8 BOM stays in .ps1 files (required for Cyrillic in PowerShell 5.1).
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
