# Окружение студии на VPS. Скопировать в `env`, заполнить, `chmod 600 env`.
#
#     cp env.template env && chmod 600 env && nano env
#
# Файл называется `env`, а НЕ `.env`: compose подхватывает `.env` из каталога
# автоматически и молча — то есть подставляет значения туда, где их не ждали,
# а забытый `.env` в репозитории превращается в утечку. Здесь обе связи явные:
#
#   * `env_file: ./env` в docker-compose.yml — переменные уезжают В КОНТЕЙНЕР;
#   * `docker compose --env-file ./env` в deploy.sh — те же значения идут в
#     ПОДСТАНОВКУ `${…}` самого compose-файла.
#
# Это разные механизмы, и одного мало: `env_file` в интерполяции не участвует,
# поэтому без флага выкладка падает на «required variable POSTGRES_PASSWORD is
# missing a value». Гонять compose руками — только с тем же флагом.
#
# В git этот файл не попадает никогда (см. .gitignore и .dockerignore).

# ── Домен и TLS ─────────────────────────────────────────────────────────────
# Обязан резолвиться в этот VPS ДО первого запуска: Caddy получает сертификат
# Let's Encrypt по HTTP-01, и без правильной A-записи выдача не пройдёт.
STUDIO_DOMAIN=studio.example.com

# ── База ────────────────────────────────────────────────────────────────────
# Учётные записи требуют Postgres: изоляция арендаторов держится на row-level
# security, а в SQLite политик нет физически — приложение откажется стартовать.
POSTGRES_DB=videopipeline

# Суперпользователь. Нужен только для initdb и pg_dump; приложение под ним НЕ
# ходит — RLS суперпользователя не касается по определению, и работа под ним
# означала бы отсутствие изоляции без единой ошибки в журнале.
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERPASSWORD=

# Роль приложения: обычная, без BYPASSRLS. Заводится при первом создании тома
# (initdb/10-app-role.sh) и владеет схемой — владельца достаёт как раз
# FORCE ROW LEVEL SECURITY.
POSTGRES_USER=app
POSTGRES_PASSWORD=

# ── Личность ────────────────────────────────────────────────────────────────
# Секрет подписи сессионного токена. НЕ КОРОЧЕ 32 БАЙТ — иначе старт откажет
# (RFC 7518 §3.2: подделываемый токен админа).
#
#     python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
#
# Смена секрета выкидывает всех вошедших. Это и способ экстренно закрыть доступ
# всем сразу, если что-то утекло.
STUDIO_SESSION_SECRET=

# Срок сессии, часы. Двенадцать — рабочий день.
SESSION_TTL_HOURS=12

# Ярлык студии. Единственный потребитель — уровень «бренд» промт-библиотеки.
STUDIO_BRAND=multik

# ── Провайдеры ──────────────────────────────────────────────────────────────
# На VPS нет Chrome, и CDP-путь там не работает: браузерная автоматизация
# (Outsee UI, ElevenLabs) требует живого профиля с логинами. Поэтому только
# API-провайдеры, а `OUTSEE_HTTP_FALLBACK_CDP` обязан быть false — иначе шаг
# будет ждать браузер, которого нет, до таймаута.
OUTSEE_HTTP_FALLBACK_CDP=false

# Текст. kie по умолчанию; альтернативы — minimax, vibecode, tokenrouter.
TEXT_LLM_PROVIDER=kie
GPT_API_KEY=
GPT_BASE_URL=https://api.kie.ai

# Картинки и видео: grsai | minimax | outsee.
IMAGE_PROVIDER=grsai
VIDEO_PROVIDER=grsai
GRSAI_API_KEY=

# MiniMax — текст, картинки и видео на одном ключе. Медиа берут стартовый кадр
# base64, поэтому публиковать кадры наружу для него не нужно.
MINIMAX_API_KEY=

# Outsee Developer API (profile outsee.io). НЕ cookies и не ключ Grsai.
OUTSEE_API_KEY=

# Озвучка.
ELEVENLABS_API_KEY=

# ── Хранилище результатов ───────────────────────────────────────────────────
# Пусто — ролики лежат на диске VPS (том app-data). Заполнено — S3-совместимое
# хранилище: диск сервера не растёт, и результат переживает пересоздание.
# Заметьте: ffmpeg монтирует с диска, а не из сети, — S3 это выдача результата,
# а не рабочий каталог.
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=auto

# ── Пределы ─────────────────────────────────────────────────────────────────
# Сколько проектов конвейер ведёт одновременно. На VPS без GPU упор в сеть и в
# лимиты провайдеров, а не в процессор; поднимать выше 2 стоит по факту, а не
# заранее.
WORKER_MAX_PARALLEL=1

# Бюджет текстовых LLM на проект, USD. Ноль — выключен. Предохранитель от
# зацикленного шага, который будет платно ходить к модели, пока не заметят.
LLM_BUDGET_USD=10

# Стартовый баланс участника в кредитах. Админа не касается — у него нет кассы.
TENANT_START_CREDITS=0

# ── Запись ответов моделей ──────────────────────────────────────────────────
# Пусто — не пишем. Задано — каждая пара «запрос → сырой ответ» ложится в этот
# каталог; оттуда случаи переносятся в голденсеты (`evals/README.md`).
# Включать на прогон, из которого собирают корпус: ответы это содержимое
# роликов и десятки килобайт на вызов.
LLM_RECORD_DIR=

# ── Telegram ────────────────────────────────────────────────────────────────
# HITL через веб-интерфейс; бот на сервере не нужен. Оставить false.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
